// quake-hl game folder: Half-Life: Opposing Force's data (from the CD) on top of ../valve, with our build of
// Opposing Force Updated's game and client libraries (sdk-op4)
game "Half-Life: Opposing Force"
startmap "of0a0"
trainmap "ofboot0"
fallback_dir "valve"
gamedll "dlls\\opfor.dll"
gamedll_linux "dlls/hl.so"
